{
  "name": "boids-flock-big",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first, mobile-optimized flocking simulation on a full-bleed HTML5 canvas. Zero runtime dependencies.",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "start:lan": "node scripts/serve.mjs --lan",
    "build": "node scripts/build.mjs",
    "bench": "node scripts/bench.mjs",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
